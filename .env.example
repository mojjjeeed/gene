# A9 configuration. Copy to .env and edit. Never commit real keys.

# --- services (defaults match `make dev-up`) ---
A9_DATABASE_URL=postgresql+psycopg://localhost:5544/a9
A9_REDIS_URL=redis://localhost:6390/0
# Shared secret between the Next route handlers and the agents service. Required.
A9_INTERNAL_KEY=
AGENTS_URL=http://127.0.0.1:8100

# --- development without an auth provider (turn both off in production) ---
A9_ENABLE_DEV_ENDPOINTS=0
# A9_DEV_USER_ID=00000000-0000-4000-8000-000000000001

# --- feature flags: one per surface, default off ---
A9_FLAG_PAPER_LIST=0

# --- models ---
# stub = deterministic placeholders (no key needed). anthropic = real calls (not yet exercised).
A9_MODEL_PROVIDER=stub
ANTHROPIC_API_KEY=
# A9_PLANNER_MODEL=claude-sonnet-5-5
# A9_TRIAGE_MODEL=claude-haiku-5-5

# --- literature sources and checks ---
# Comma-separated: europe_pmc,pubmed,openalex,crossref,arxiv,biorxiv,medrxiv (fixture,fixture_down,fixture_partial need no network)
A9_SOURCES=europe_pmc,pubmed,openalex,crossref,arxiv,biorxiv,medrxiv
A9_SOURCE_LIMIT=100
A9_RETRACTION_CHECK=crossref
A9_EMBEDDER=hashing
# Optional: raises rate limits at NCBI. Contact email is sent to sources ONLY if you set it.
NCBI_API_KEY=
A9_CONTACT_EMAIL=
A9_FULLTEXT=on
