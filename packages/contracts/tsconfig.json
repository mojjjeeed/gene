{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["ts/**/*.ts", "scripts/**/*.mjs", "tests/**/*.ts"],
  "exclude": ["tests/fixtures/**"]
}
